{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts"
    ],
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.11",
        "tsx": "^4.23.15"
    },
    "dependencies": {
        "express": "^5.3.0"
    }
    
}
